+++ b/arch/wasm/configs/wasm_defconfig
@@ -37,10 +37,17 @@ CONFIG_DEVTMPFS=y
 CONFIG_DEVTMPFS_MOUNT=y
 # CONFIG_FW_LOADER is not set
 # CONFIG_ALLOW_DEV_COREDUMP is not set
-# CONFIG_INPUT is not set
+CONFIG_INPUT_EVDEV=y
+# CONFIG_INPUT_KEYBOARD is not set
+# CONFIG_INPUT_MOUSE is not set
 # CONFIG_SERIO is not set
-# CONFIG_VT is not set
 # CONFIG_LEGACY_PTYS is not set
+CONFIG_FB=y
+CONFIG_FRAMEBUFFER_CONSOLE=y
+CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
+CONFIG_FONTS=y
+CONFIG_FONT_8x16=y
+CONFIG_FONT_TER16x32=y
 # CONFIG_HW_RANDOM is not set
 # CONFIG_HWMON is not set
 # CONFIG_USB_SUPPORT is not set
diff --git a/arch/wasm/drivers/Kconfig b/arch/wasm/drivers/Kconfig
index caf1afa17..b452b6c99 100644
--- a/arch/wasm/drivers/Kconfig
+++ b/arch/wasm/drivers/Kconfig
@@ -6,3 +6,19 @@ config WASM_CONSOLE
 	default y
 	help
 	  Kernel messages and a tty on the host's debug terminal.
+
+config WASM_FB
+	bool "Framebuffer on the host canvas"
+	depends on FB
+	select FB_SYSMEM_HELPERS
+	select FB_PROVIDE_GET_FB_UNMAPPED_AREA
+	default y
+	help
+	  /dev/fb0, shown on the page's canvas.
+
+config WASM_INPUT
+	bool "Host keyboard and pointer"
+	depends on INPUT
+	default y
+	help
+	  Keyboard and absolute pointer events from the page.
