From b18fe3aa8957fa387e975a0561821b0a593435fc Mon Sep 17 00:00:00 2001
From: dynamiteswag81 <318143412+dynamiteswag81@users.noreply.github.com>
Date: Fri, 16 Oct 2026 16:59:24 -0400
Subject: [PATCH 2/3] wasm: register irq/timer shared state with the host, halt
 on panic

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/wasm/include/asm/wasm.h |  2 +-
 arch/wasm/kernel/setup.c     | 21 +++++++++++++++++++++
 2 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/arch/wasm/include/asm/wasm.h b/arch/wasm/include/asm/wasm.h
index e4665b072..685c50ac9 100644
--- a/arch/wasm/include/asm/wasm.h
+++ b/arch/wasm/include/asm/wasm.h
@@ -58,7 +58,7 @@ void __noreturn wasm_host_vfork_resume(unsigned long jmpbuf, long val)
 /* tell the host about a device's shared state */
 void wasm_host_dev_register(const char *type, void *state)
 	__wasm_import("dev_register");
-/* stop (0) or restart (1) the machine */
+/* stop (0), restart (1) or panic (2) the machine */
 void __noreturn wasm_host_halt(int reboot) __wasm_import("halt");
 
 /* --- shared state ------------------------------------------------------ */
diff --git a/arch/wasm/kernel/setup.c b/arch/wasm/kernel/setup.c
index 7c79038c8..9f284538b 100644
--- a/arch/wasm/kernel/setup.c
+++ b/arch/wasm/kernel/setup.c
@@ -27,6 +27,8 @@
 #include <linux/seq_file.h>
 #include <linux/screen_info.h>
 #include <linux/delay.h>
+#include <linux/panic_notifier.h>
+#include <linux/notifier.h>
 
 #include <asm/wasm.h>
 #include <asm/sections.h>
@@ -109,10 +111,29 @@ static void __init wasm_paging_init(void)
 	free_area_init(max_zone_pfn);
 }
 
+static int wasm_panic_event(struct notifier_block *nb, unsigned long event,
+			    void *msg)
+{
+	/* stop the machine instead of spinning in panic() forever */
+	wasm_host_halt(2);
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block wasm_panic_nb = {
+	.notifier_call	= wasm_panic_event,
+	.priority	= INT_MIN,
+};
+
 void __init setup_arch(char **cmdline_p)
 {
 	unsigned long kernel_end = PAGE_ALIGN((unsigned long)__heap_base);
 
+	/* the host's timer worker and device code poke these directly */
+	wasm_host_dev_register("irq", &wasm_irq_pending);
+	wasm_host_dev_register("timer_deadline", &wasm_timer_deadline);
+	wasm_host_dev_register("timer_seq", &wasm_timer_seq);
+	atomic_notifier_chain_register(&panic_notifier_list, &wasm_panic_nb);
+
 	wasm_host_get_cmdline(boot_command_line, COMMAND_LINE_SIZE);
 	*cmdline_p = boot_command_line;
 
-- 
