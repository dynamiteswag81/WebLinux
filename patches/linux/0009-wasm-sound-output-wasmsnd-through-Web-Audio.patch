 # CONFIG_LEGACY_PTYS is not set
+CONFIG_SOUND=y
+CONFIG_SND=y
+CONFIG_SND_OSSEMUL=y
+CONFIG_SND_PCM_OSS=y
+# CONFIG_SND_DRIVERS is not set
+# CONFIG_SND_SPI is not set
+# CONFIG_SND_X86 is not set
 CONFIG_FB=y
 CONFIG_FRAMEBUFFER_CONSOLE=y
 CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
diff --git a/arch/wasm/drivers/Kconfig b/arch/wasm/drivers/Kconfig
index 8d7c58a6c..e9b77676a 100644
--- a/arch/wasm/drivers/Kconfig
+++ b/arch/wasm/drivers/Kconfig
@@ -37,3 +37,11 @@ config WASM_NET
 	help
 	  Ethernet frames to the host page, which routes them (NAT) to the
 	  real network through the page server.
