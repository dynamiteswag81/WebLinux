diff --git a/arch/wasm/include/asm/processor.h b/arch/wasm/include/asm/processor.h
new file mode 100644
index 000000000..6e861c0c5
--- /dev/null
+++ b/arch/wasm/include/asm/processor.h
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _ASM_WASM_PROCESSOR_H
+#define _ASM_WASM_PROCESSOR_H
+
+#ifndef __ASSEMBLER__
+
+#include <linux/types.h>
+#include <asm/ptrace.h>
+
+struct task_struct;
+struct wasm_wctl;
+
+/* How a task's kernel context gets resumed when it is switched to. */
+enum wasm_ctx {
+	WASM_CTX_NATIVE = 0,	/* return from __switch_to (frames are live) */
+	WASM_CTX_FORK,		/* fresh worker: run thread.fn or user code */
+	WASM_CTX_VFORK_RESUME,	/* longjmp back to the vfork() call site */
+};
+
+/* Information handed to the host to start a freshly exec'd program. */
+struct wasm_user_start {
+	u32 image;		/* module bytes */
+	u32 image_len;
+	u32 mem_base;		/* __memory_base for the module's data */
+	u32 table_size;		/* function table entries the module needs */
+	u32 stack_top;		/* initial __stack_pointer */
+	u32 args;		/* argc/argv/envp/auxv block for _start */
+	u32 tls_base;		/* thread local storage block */
+	u32 pid;
+};
+
+struct thread_struct {
+	struct wasm_wctl *wctl;		/* worker hosting our kernel context */
+	unsigned int ctx;		/* enum wasm_ctx */
+	unsigned int in_user;		/* user code is running */
+	int (*fn)(void *);		/* kernel thread entry */
+	void *fn_arg;
+	/* vfork bookkeeping */
+	unsigned int vforking;		/* inside the wasm_vfork syscall */
+	struct task_struct *vfork_parent;
+	struct task_struct *vfork_child;
+	struct task_struct *vfork_wake;	/* exec'd child to wake on resume */
+	unsigned long vfork_jmpbuf;
+	long vfork_pid;
+	/* user program state */
+	unsigned long sigmailbox;
+	unsigned int restart;		/* re-run the syscall after signals */
+	unsigned int exec_pending;
+	struct wasm_user_start exec_info;
+	void *exec_image;		/* module bytes, freed once started */
+};
+
+#define INIT_THREAD  { .wctl = NULL, }
+
+extern unsigned long memory_end;
+
+/* !MMU: user space is any valid address in linear memory */
+#define TASK_SIZE		(memory_end)
+#define TASK_SIZE_MAX		TASK_SIZE
+#define STACK_TOP		TASK_SIZE
+#define STACK_TOP_MAX		STACK_TOP
+#define TASK_UNMAPPED_BASE	0
+
+#define cpu_relax()		__asm__ __volatile__("" : : : "memory")
+
+#define KSTK_EIP(tsk)		0UL
+#define KSTK_ESP(tsk)		0UL
+
+#define task_pt_regs(tsk) \
+	((struct pt_regs *)((unsigned long)task_stack_page(tsk) + THREAD_SIZE) - 1)
+
+unsigned long __get_wchan(struct task_struct *p);
+
+#endif /* __ASSEMBLER__ */
+#endif /* _ASM_WASM_PROCESSOR_H */
