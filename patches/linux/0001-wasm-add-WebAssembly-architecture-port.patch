diff --git a/arch/wasm/include/uapi/asm/wasm.h b/arch/wasm/include/uapi/asm/wasm.h
new file mode 100644
index 000000000..334e4029f
--- /dev/null
+++ b/arch/wasm/include/uapi/asm/wasm.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_ASM_WASM_WASM_H
+#define _UAPI_ASM_WASM_WASM_H
+
+#include <linux/types.h>
+
+/*
+ * Signal delivery.  Wasm code can't be redirected to a handler from the
+ * outside, so user space registers a mailbox (wasm_sigmailbox syscall).
+ * When a handler must run, the kernel fills the mailbox and sets "pending"
+ * before the syscall returns.  The libc syscall wrapper notices it, copies
+ * the frame to its stack, runs the handler and calls rt_sigreturn(frame).
+ */
+struct wasm_sigframe {
+	__u32 handler;		/* function table index of the handler */
+	__u32 flags;		/* sa_flags */
+	__u32 sig;
+	__u32 restart;		/* 1: re-issue the interrupted syscall */
+	__s32 retval;		/* syscall result if not restarted */
+	__u32 _pad;
+	__u64 saved_mask;	/* blocked set to restore on sigreturn */
+	__u8 info[128];		/* siginfo_t */
+	__u8 uc[64];		/* minimal ucontext (uc_sigmask lives here) */
+};
+
+struct wasm_sigmailbox {
+	__u32 pending;
+	__u32 _pad;
+	struct wasm_sigframe frame;
+};
+
+/* Returned by vfork in the child; the parent gets the pid via longjmp. */
+#define WASM_VFORK_CHILD	0
+
+#endif
