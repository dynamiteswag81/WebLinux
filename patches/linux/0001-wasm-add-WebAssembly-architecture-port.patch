diff --git a/arch/wasm/include/asm/wasm.h b/arch/wasm/include/asm/wasm.h
new file mode 100644
index 000000000..e4665b072
--- /dev/null
+++ b/arch/wasm/include/asm/wasm.h
@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Interface between the kernel and the host runtime (arch/wasm/host).
+ *
+ * Calls into the host are wasm imports from the "host" module.  The host
+ * calls into the kernel through exported functions.  Everything else goes
+ * through the shared linear memory using wasm atomics.
+ */
+#ifndef _ASM_WASM_WASM_H
+#define _ASM_WASM_WASM_H
+
+#include <linux/types.h>
+#include <linux/compiler.h>
+#include <uapi/asm/wasm.h>
+
+#define __wasm_import(name) \
+	__attribute__((import_module("host"), import_name(name)))
+#define __wasm_export(name) \
+	__attribute__((export_name(name))) __used
+
+/* Interrupt lines.  The host sets bits in wasm_irq_pending. */
+#define WASM_IRQ_TIMER		0
+#define WASM_IRQ_CONSOLE	1
+#define WASM_IRQ_INPUT		2
+#define WASM_IRQ_BLOCK		3
+#define WASM_IRQ_NET		4
+#define WASM_IRQ_HOST		5
+#define WASM_NR_IRQS		8
+
+struct task_struct;
+struct wasm_wctl;
+
+/* --- host imports ------------------------------------------------------ */
+
+void wasm_host_console_write(const char *buf, unsigned int len)
+	__wasm_import("console_write");
+/* monotonic and wall clock, nanoseconds */
+u64 wasm_host_now_ns(void) __wasm_import("now_ns");
+u64 wasm_host_wall_ns(void) __wasm_import("wall_ns");
+/* copy the boot command line into buf, returns its length */
+int wasm_host_get_cmdline(char *buf, int size) __wasm_import("get_cmdline");
+/* initial ramdisk */
+unsigned long wasm_host_initrd_size(void) __wasm_import("initrd_size");
+void wasm_host_initrd_load(void *dst) __wasm_import("initrd_load");
+/* start a worker that will run task @p (see wasm_task_entry) */
+void wasm_host_spawn(struct task_struct *p, struct wasm_wctl *w,
+		     unsigned long stack_top, unsigned long tls)
+	__wasm_import("spawn");
+/* stop the worker of a task that never ran */
+void wasm_host_kill_worker(struct wasm_wctl *w) __wasm_import("kill_worker");
+/* the calling worker has nothing left to run: terminate it */
+void __noreturn wasm_host_exit_worker(void) __wasm_import("exit_worker");
+/* unwind to the worker loop and start the program described by @x */
+void __noreturn wasm_host_start_user(void *x) __wasm_import("start_user");
+/* unwind to user space: longjmp(jmpbuf, val) inside the user module */
+void __noreturn wasm_host_vfork_resume(unsigned long jmpbuf, long val)
+	__wasm_import("vfork_resume");
+/* tell the host about a device's shared state */
+void wasm_host_dev_register(const char *type, void *state)
+	__wasm_import("dev_register");
+/* stop (0) or restart (1) the machine */
+void __noreturn wasm_host_halt(int reboot) __wasm_import("halt");
+
+/* --- shared state ------------------------------------------------------ */
+
+extern unsigned int wasm_irq_pending;
+extern u64 wasm_timer_deadline;
+extern unsigned int wasm_timer_seq;
+extern unsigned long memory_end;
+
+static inline void wasm_raise_local_irq(unsigned int irq)
+{
+	__atomic_fetch_or(&wasm_irq_pending, 1U << irq, __ATOMIC_SEQ_CST);
+}
+
+static inline void wasm_notify(void *addr)
+{
+	__builtin_wasm_memory_atomic_notify((int *)addr, ~0U);
+}
+
+#endif /* _ASM_WASM_WASM_H */
