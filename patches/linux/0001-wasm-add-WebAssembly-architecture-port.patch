+# SPDX-License-Identifier: GPL-2.0
+#
+# WebAssembly architecture.
+#
+# The kernel is compiled to a single wasm32 module.  Every task runs inside
+# its own host worker (a JavaScript Web Worker) that instantiates the kernel
+# module against one shared linear memory.  Context switches hand a baton
+# from one worker to another with memory.atomic.wait/notify, so exactly one
+# worker executes kernel or user code at any time (a uniprocessor machine).
+#
+# Wasm has no MMU, so this is a !MMU port.  User programs are separate wasm
+# modules (position independent) loaded by binfmt_wasm.
+#
+
+config WASM
+	def_bool y
+	select ARCH_HAS_SYSCALL_WRAPPER
+	select ARCH_NO_PREEMPT
+	select BINFMT_WASM
+	select GENERIC_ATOMIC64
+	select GENERIC_CLOCKEVENTS
+	select GENERIC_CPU_DEVICES
+	select GENERIC_IRQ_SHOW
+	select GENERIC_STRNCPY_FROM_USER
+	select GENERIC_STRNLEN_USER
+	select HAVE_EXIT_THREAD
+	select HAVE_PAGE_SIZE_4KB
+	select HAVE_GENERIC_TIF_BITS
+	select HAVE_SECTIONLESS_INITCALLS
+	select THREAD_INFO_IN_TASK
+	select UACCESS_MEMCPY
+
+config 32BIT
+	def_bool y
+
+config 64BIT
+	def_bool n
+
+config GENERIC_CSUM
+	def_bool y
+
+config GENERIC_HWEIGHT
+	def_bool y
+
+config NO_IOPORT_MAP
+	def_bool y
+
+config ARCH_FORCE_MAX_ORDER
+	int
+	default 12
+	help
+	  !MMU systems need large physically contiguous allocations for
+	  program images and the framebuffer, so allow up to 16 MiB blocks.
+
+config PGTABLE_LEVELS
+	int
+	default 2
+
+config BINFMT_WASM
+	bool
+	help
+	  Run WebAssembly modules as user programs.  The module must be
+	  position independent (wasm-ld -pie) and import the shared memory.
+
+config HAVE_SECTIONLESS_INITCALLS
+	bool
+	help
+	  The linker cannot order named output sections, so every initcall
+	  level gets its own C-identifier section and the boundaries come
+	  from linker generated __start_/__stop_ symbols.
+
+menu "WebAssembly platform"
+
+config WASM_KERNEL_STACK_ORDER
+	int "Kernel stack size order (pages)"
+	default 3
+	help
+	  Each task gets a 2^N page shadow stack in linear memory for
+	  address-taken locals.  The wasm engine keeps the real call stack.
+
+config WASM_USER_STACK_SIZE
+	int "Default stack size for user programs (KiB)"
+	default 256
+
+source "kernel/Kconfig.hz"
+
+source "arch/wasm/drivers/Kconfig"
+
+endmenu
