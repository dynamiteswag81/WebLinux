diff --git a/arch/wasm/include/asm/irqflags.h b/arch/wasm/include/asm/irqflags.h
new file mode 100644
index 000000000..660c498e7
--- /dev/null
+++ b/arch/wasm/include/asm/irqflags.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Interrupts are virtual.  The host sets bits in wasm_irq_pending and the
+ * kernel services them whenever interrupts get (re-)enabled, or from the
+ * idle loop.  A wasm instance can't be interrupted asynchronously, but any
+ * point where interrupts are enabled is a legal interrupt point, so this
+ * keeps the usual semantics.
+ */
+#ifndef _ASM_WASM_IRQFLAGS_H
+#define _ASM_WASM_IRQFLAGS_H
+
+#ifndef __ASSEMBLER__
+
+#define ARCH_IRQ_DISABLED	0
+#define ARCH_IRQ_ENABLED	1
+
+extern unsigned long wasm_irq_flags;
+extern unsigned int wasm_irq_pending;
+void wasm_do_irqs(void);
+
+#define __wasm_irq_barrier() __asm__ __volatile__("" : : : "memory")
+
+static inline unsigned long arch_local_save_flags(void)
+{
+	return *(volatile unsigned long *)&wasm_irq_flags;
+}
+
+static inline void arch_local_irq_restore(unsigned long flags)
+{
+	__wasm_irq_barrier();
+	*(volatile unsigned long *)&wasm_irq_flags = flags;
+	if (flags && __atomic_load_n(&wasm_irq_pending, __ATOMIC_RELAXED))
+		wasm_do_irqs();
+	__wasm_irq_barrier();
+}
+
+static inline unsigned long arch_local_irq_save(void)
+{
+	unsigned long flags = arch_local_save_flags();
+
+	*(volatile unsigned long *)&wasm_irq_flags = ARCH_IRQ_DISABLED;
+	__wasm_irq_barrier();
+	return flags;
+}
+
+static inline void arch_local_irq_enable(void)
+{
+	arch_local_irq_restore(ARCH_IRQ_ENABLED);
+}
+
+static inline void arch_local_irq_disable(void)
+{
+	*(volatile unsigned long *)&wasm_irq_flags = ARCH_IRQ_DISABLED;
+	__wasm_irq_barrier();
+}
+
+static inline int arch_irqs_disabled_flags(unsigned long flags)
+{
+	return flags == ARCH_IRQ_DISABLED;
+}
+
+static inline int arch_irqs_disabled(void)
+{
+	return arch_irqs_disabled_flags(arch_local_save_flags());
+}
+
+#endif /* __ASSEMBLER__ */
+#endif /* _ASM_WASM_IRQFLAGS_H */
