diff --git a/arch/wasm/kernel/syscalls.c b/arch/wasm/kernel/syscalls.c
new file mode 100644
index 000000000..c9720ee47
--- /dev/null
+++ b/arch/wasm/kernel/syscalls.c
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * WebAssembly specific system calls.
+ */
+
+#include <linux/sched.h>
+#include <linux/sched/task.h>
+#include <linux/syscalls.h>
+#include <linux/mm.h>
+
+#include "wasm_internal.h"
+
+/*
+ * vfork(): libc calls this right after setjmp(jmpbuf).  The child takes
+ * over this worker and returns 0 from here.  The parent is frozen; when
+ * the child execs or exits the parent resumes with longjmp(jmpbuf, pid).
+ */
+SYSCALL_DEFINE1(wasm_vfork, unsigned long, jmpbuf)
+{
+	struct task_struct *parent = current;
+	struct kernel_clone_args args = {
+		.flags		= CLONE_VM,
+		.exit_signal	= SIGCHLD,
+	};
+	pid_t pid;
+
+	if (!jmpbuf)
+		return -EINVAL;
+
+	parent->thread.vforking = 1;
+	pid = kernel_clone(&args);
+	parent->thread.vforking = 0;
+	if (pid < 0)
+		return pid;
+
+	parent->thread.vfork_jmpbuf = jmpbuf;
+	parent->thread.vfork_pid = pid;
+	parent->thread.ctx = WASM_CTX_VFORK_RESUME;
+
+	set_current_state(TASK_UNINTERRUPTIBLE);
+	schedule();
+
+	/* this worker now runs the child */
+	return 0;
+}
+
+/* Register the signal mailbox (see signal.c). */
+SYSCALL_DEFINE1(wasm_sigmailbox, unsigned long, addr)
+{
+	current->thread.sigmailbox = addr;
+	return 0;
+}
+
+SYSCALL_DEFINE6(mmap2, unsigned long, addr, unsigned long, len,
+		unsigned long, prot, unsigned long, flags,
+		unsigned long, fd, unsigned long, pgoff)
+{
+	/* the offset is in 4096 byte units on every 32-bit ABI */
+	return ksys_mmap_pgoff(addr, len, prot, flags, fd,
+			       pgoff >> (PAGE_SHIFT - 12));
+}
+
+SYSCALL_DEFINE0(ni_syscall)
+{
+	return -ENOSYS;
+}
diff --git a/arch/wasm/kernel/time.c b/arch/wasm/kernel/time.c
new file mode 100644
index 000000000..edd8cac0f
--- /dev/null
+++ b/arch/wasm/kernel/time.c
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Time keeping.
+ *
+ * Clocksource: the host's monotonic clock (performance.now()) in ns.
+ * Clockevents: a one-shot deadline in shared memory.  A host timer worker
+ * sleeps until the deadline, then raises WASM_IRQ_TIMER.
+ */
+
+#include <linux/init.h>
+#include <linux/clocksource.h>
+#include <linux/clockchips.h>
+#include <linux/interrupt.h>
+#include <linux/delay.h>
+#include <linux/timex.h>
+#include <linux/sched_clock.h>
+#include <linux/time.h>
+
+#include <asm/wasm.h>
+
+u64 wasm_timer_deadline;
+unsigned int wasm_timer_seq;
+
+static u64 wasm_clock_read(struct clocksource *cs)
+{
+	return wasm_host_now_ns();
+}
+
+static struct clocksource wasm_clocksource = {
+	.name	= "wasm",
+	.rating	= 300,
+	.read	= wasm_clock_read,
+	.mask	= CLOCKSOURCE_MASK(64),
+	.flags	= CLOCK_SOURCE_IS_CONTINUOUS,
+};
+
+unsigned long long notrace sched_clock(void)
+{
+	return wasm_host_now_ns();
+}
+
+static void wasm_timer_program(u64 deadline)
+{
+	__atomic_store_n(&wasm_timer_deadline, deadline, __ATOMIC_SEQ_CST);
+	__atomic_fetch_add(&wasm_timer_seq, 1, __ATOMIC_SEQ_CST);
+	wasm_notify(&wasm_timer_seq);
+}
+
+static int wasm_timer_next_event(unsigned long delta,
+				 struct clock_event_device *evt)
+{
+	wasm_timer_program(wasm_host_now_ns() + delta);
+	return 0;
+}
+
+static int wasm_timer_shutdown(struct clock_event_device *evt)
+{
+	wasm_timer_program(0);
+	return 0;
+}
+
+static struct clock_event_device wasm_clockevent = {
+	.name			= "wasm-timer",
+	.features		= CLOCK_EVT_FEAT_ONESHOT,
+	.rating			= 300,
+	.set_next_event		= wasm_timer_next_event,
+	.set_state_shutdown	= wasm_timer_shutdown,
+	.set_state_oneshot_stopped = wasm_timer_shutdown,
+};
+
+static irqreturn_t wasm_timer_interrupt(int irq, void *dev_id)
+{
+	struct clock_event_device *evt = dev_id;
+
+	evt->event_handler(evt);
+	return IRQ_HANDLED;
+}
+
+void __init time_init(void)
+{
+	int ret;
+
+	clocksource_register_hz(&wasm_clocksource, NSEC_PER_SEC);
+
+	ret = request_irq(WASM_IRQ_TIMER, wasm_timer_interrupt, IRQF_TIMER,
+			  "timer", &wasm_clockevent);
+	if (ret)
+		panic("wasm: can't request timer irq: %d\n", ret);
+
+	wasm_clockevent.cpumask = cpumask_of(0);
+	clockevents_config_and_register(&wasm_clockevent, NSEC_PER_SEC,
+					1000, 0x7fffffff);
+
+}
+
+/* udelay() spins on the host clock, so there is nothing to calibrate */
+void calibrate_delay(void)
+{
+	loops_per_jiffy = 1000000000 / HZ;
+	pr_info("Calibrating delay loop... skipped (host clock)\n");
+}
+
+void read_persistent_clock64(struct timespec64 *ts)
+{
+	u64 ns = wasm_host_wall_ns();
+
+	ts->tv_sec = div_u64(ns, NSEC_PER_SEC);
+	ts->tv_nsec = ns - ts->tv_sec * NSEC_PER_SEC;
+}
+
+/* --- delays ------------------------------------------------------------ */
+
+static void wasm_spin_ns(u64 ns)
+{
+	u64 end = wasm_host_now_ns() + ns;
+
+	while (wasm_host_now_ns() < end)
+		cpu_relax();
+}
+
+void __delay(unsigned long loops)
+{
+	wasm_spin_ns(loops);
+}
+EXPORT_SYMBOL(__delay);
+
+void __udelay(unsigned long usecs)
+{
+	wasm_spin_ns((u64)usecs * NSEC_PER_USEC);
+}
+EXPORT_SYMBOL(__udelay);
+
+void __ndelay(unsigned long nsecs)
+{
+	wasm_spin_ns(nsecs);
+}
+EXPORT_SYMBOL(__ndelay);
+
+void __const_udelay(unsigned long xloops)
+{
+	/* xloops = usecs * 2^32 / 10^6 */
+	wasm_spin_ns(((u64)xloops * NSEC_PER_SEC) >> 32);
+}
+EXPORT_SYMBOL(__const_udelay);
