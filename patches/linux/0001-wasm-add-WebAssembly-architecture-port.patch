new file mode 100644
index 000000000..2d52c6727
--- /dev/null
+++ b/arch/wasm/lib/multi3.c
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * 128-bit multiply.  clang lowers __int128 multiplication on wasm32 to a
+ * call to this compiler runtime routine.
+ */
+
+#include <linux/types.h>
+
+typedef __int128 ti_int;
+typedef unsigned __int128 tu_int;
+
+ti_int __multi3(ti_int a, ti_int b);
+
+ti_int __multi3(ti_int a, ti_int b)
+{
+	u64 al = (u64)a, ah = (u64)((tu_int)a >> 64);
+	u64 bl = (u64)b, bh = (u64)((tu_int)b >> 64);
+	u64 a0 = al & 0xffffffff, a1 = al >> 32;
+	u64 b0 = bl & 0xffffffff, b1 = bl >> 32;
+	u64 p00 = a0 * b0, p01 = a0 * b1, p10 = a1 * b0, p11 = a1 * b1;
+	u64 mid = (p00 >> 32) + (p01 & 0xffffffff) + (p10 & 0xffffffff);
+	u64 lo = (mid << 32) | (p00 & 0xffffffff);
+	u64 hi = p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32);
+
+	hi += al * bh + ah * bl;
+	return (ti_int)(((tu_int)hi << 64) | lo);
+}
