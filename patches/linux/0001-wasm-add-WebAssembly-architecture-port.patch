diff --git a/arch/wasm/drivers/console.c b/arch/wasm/drivers/console.c
new file mode 100644
index 000000000..84ca32e6e
--- /dev/null
+++ b/arch/wasm/drivers/console.c
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Host console: kernel messages go to the host's log, and ttyW0 is a tty
+ * on the host's debug terminal.
+ *
+ * Output is a synchronous host call.  Input arrives through a ring in
+ * shared memory: the host appends bytes at head and raises
+ * WASM_IRQ_CONSOLE, the kernel consumes from tail.
+ */
+
+#include <linux/console.h>
+#include <linux/tty.h>
+#include <linux/tty_driver.h>
+#include <linux/tty_flip.h>
+#include <linux/interrupt.h>
+#include <linux/init.h>
+#include <linux/module.h>
+
+#include <asm/wasm.h>
+
+#define WASM_CONS_RING	4096
+
+struct wasm_cons_ring {
+	u32 head;		/* written by the host */
+	u32 tail;		/* written by the kernel */
+	u8 buf[WASM_CONS_RING];
+};
+
+static struct wasm_cons_ring wasm_cons_in;
+static struct tty_port wasm_tty_port;
+static struct tty_driver *wasm_tty_driver;
+
+static void wasm_console_write(struct console *co, const char *s,
+			       unsigned int n)
+{
+	wasm_host_console_write(s, n);
+}
+
+static struct tty_driver *wasm_console_device(struct console *co, int *index)
+{
+	*index = co->index;
+	return wasm_tty_driver;
+}
+
+static struct console wasm_console = {
+	.name	= "ttyW",
+	.write	= wasm_console_write,
+	.device	= wasm_console_device,
+	.flags	= CON_PRINTBUFFER,
+	.index	= -1,
+};
+
+static int __init wasm_console_init(void)
+{
+	register_console(&wasm_console);
+	return 0;
+}
+console_initcall(wasm_console_init);
+
+static int wasm_tty_open(struct tty_struct *tty, struct file *filp)
+{
+	return tty_port_open(&wasm_tty_port, tty, filp);
+}
+
+static void wasm_tty_close(struct tty_struct *tty, struct file *filp)
+{
+	tty_port_close(&wasm_tty_port, tty, filp);
+}
+
+static ssize_t wasm_tty_write(struct tty_struct *tty, const u8 *buf,
+			      size_t count)
+{
+	wasm_host_console_write((const char *)buf, count);
+	return count;
+}
+
+static unsigned int wasm_tty_write_room(struct tty_struct *tty)
+{
+	return 65536;
+}
+
+static const struct tty_operations wasm_tty_ops = {
+	.open		= wasm_tty_open,
+	.close		= wasm_tty_close,
+	.write		= wasm_tty_write,
+	.write_room	= wasm_tty_write_room,
+};
+
+static const struct tty_port_operations wasm_tty_port_ops = {
+};
+
+static irqreturn_t wasm_console_irq(int irq, void *dev_id)
+{
+	u32 head = __atomic_load_n(&wasm_cons_in.head, __ATOMIC_ACQUIRE);
+	u32 tail = wasm_cons_in.tail;
+
+	while (tail != head) {
+		tty_insert_flip_char(&wasm_tty_port,
+				     wasm_cons_in.buf[tail % WASM_CONS_RING],
+				     TTY_NORMAL);
+		tail++;
+	}
+	__atomic_store_n(&wasm_cons_in.tail, tail, __ATOMIC_RELEASE);
+	tty_flip_buffer_push(&wasm_tty_port);
+	return IRQ_HANDLED;
+}
+
+static int __init wasm_tty_init(void)
+{
+	struct tty_driver *driver;
+	int ret;
+
+	driver = tty_alloc_driver(1, TTY_DRIVER_REAL_RAW |
+				     TTY_DRIVER_RESET_TERMIOS);
+	if (IS_ERR(driver))
+		return PTR_ERR(driver);
+
+	driver->driver_name = "wasm_console";
+	driver->name = "ttyW";
+	driver->major = 0;
+	driver->minor_start = 0;
+	driver->type = TTY_DRIVER_TYPE_SYSTEM;
+	driver->subtype = SYSTEM_TYPE_CONSOLE;
+	driver->init_termios = tty_std_termios;
+	tty_set_operations(driver, &wasm_tty_ops);
+
+	tty_port_init(&wasm_tty_port);
+	wasm_tty_port.ops = &wasm_tty_port_ops;
+	tty_port_link_device(&wasm_tty_port, driver, 0);
+
+	ret = tty_register_driver(driver);
+	if (ret) {
+		tty_driver_kref_put(driver);
+		return ret;
+	}
+	wasm_tty_driver = driver;
+
+	ret = request_irq(WASM_IRQ_CONSOLE, wasm_console_irq, 0, "console",
+			  NULL);
+	if (ret)
+		pr_err("wasm console: no irq (%d)\n", ret);
+
+	wasm_host_dev_register("console", &wasm_cons_in);
+	return 0;
+}
+device_initcall(wasm_tty_init);
