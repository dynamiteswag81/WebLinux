+
+#include <linux/atomic.h>
+
+struct task_struct;
+struct pt_regs;
+
+/* Worker control block: one per host worker. */
+struct wasm_wctl {
+	unsigned int futex;		/* 1 = run; set by the switching task */
+	unsigned int nr_hosted;		/* tasks whose context lives here */
+	struct task_struct *active;	/* task to continue as when woken */
+	struct task_struct *last;	/* task that switched to us */
+	atomic_t refs;			/* tasks pointing at this wctl */
+};
+
+extern struct wasm_wctl wasm_boot_wctl;
+extern __thread struct wasm_wctl *wasm_this_wctl;
+
+struct wasm_wctl *wasm_wctl_alloc(void);
+void wasm_wctl_put(struct wasm_wctl *w);
+void wasm_spawn_worker(struct task_struct *p);
+
+/* kernel/sched/core.c: finish a switch into a task without live frames */
+void wasm_schedule_resume(struct task_struct *prev);
+
+void wasm_exit_to_user(struct pt_regs *regs);
+void __noreturn wasm_start_exec(void);
+void wasm_do_signal(struct pt_regs *regs);
+
+#endif
