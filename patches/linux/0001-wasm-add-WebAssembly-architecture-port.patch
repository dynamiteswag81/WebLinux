+#ifndef _ASM_WASM_CURRENT_H
+#define _ASM_WASM_CURRENT_H
+
+#ifndef __ASSEMBLER__
+
+struct task_struct;
+
+/*
+ * Every worker has its own instance of the kernel module, and wasm thread
+ * local storage is per instance.  A worker only ever runs the task(s) it
+ * hosts, so "current" is simply a TLS variable that __switch_to updates.
+ */
+extern __thread struct task_struct *wasm_current_task;
+
+static __always_inline struct task_struct *get_current(void)
+{
+	return wasm_current_task;
+}
+
+#define current get_current()
+
+#endif /* __ASSEMBLER__ */
