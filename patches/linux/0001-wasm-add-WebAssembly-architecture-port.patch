diff --git a/arch/wasm/include/asm/syscall_wrapper.h b/arch/wasm/include/asm/syscall_wrapper.h
new file mode 100644
index 000000000..fc6cd64b3
--- /dev/null
+++ b/arch/wasm/include/asm/syscall_wrapper.h
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Syscall wrappers.  Wasm traps if a function is called indirectly through
+ * a pointer of the wrong type, so every table entry must have the same
+ * signature: long (const struct pt_regs *).  Arguments sit in 32-bit slots
+ * and 64-bit values occupy two consecutive slots (low word first).
+ */
+#ifndef _ASM_WASM_SYSCALL_WRAPPER_H
+#define _ASM_WASM_SYSCALL_WRAPPER_H
+
+#include <asm/ptrace.h>
+
+#define __SYSCALL_SE_DEFINEx(x, prefix, name, ...)			\
+	static long __se_##prefix##name(__MAP(x,__SC_LONG,__VA_ARGS__)); \
+	static long __se_##prefix##name(__MAP(x,__SC_LONG,__VA_ARGS__))
+
+#define __WSZ(t)	(__TYPE_IS_LL(t) ? 2 : 1)
+
+#define __WSLOT(off)	((unsigned long)regs->args[(off) % 6])
+
+#define __WGET(t, off)							\
+	__builtin_choose_expr(__TYPE_IS_LL(t),				\
+		(long long)((unsigned long long)__WSLOT(off) |		\
+			    ((unsigned long long)__WSLOT((off) + 1) << 32)), \
+		regs->args[(off) % 6])
+
+#define __WARGS1(t1, a1) \
+	__WGET(t1, 0)
+#define __WARGS2(t1, a1, t2, a2) \
+	__WARGS1(t1, a1), __WGET(t2, __WSZ(t1))
+#define __WARGS3(t1, a1, t2, a2, t3, a3) \
+	__WARGS2(t1, a1, t2, a2), __WGET(t3, __WSZ(t1) + __WSZ(t2))
+#define __WARGS4(t1, a1, t2, a2, t3, a3, t4, a4) \
+	__WARGS3(t1, a1, t2, a2, t3, a3), \
+	__WGET(t4, __WSZ(t1) + __WSZ(t2) + __WSZ(t3))
+#define __WARGS5(t1, a1, t2, a2, t3, a3, t4, a4, t5, a5) \
+	__WARGS4(t1, a1, t2, a2, t3, a3, t4, a4), \
+	__WGET(t5, __WSZ(t1) + __WSZ(t2) + __WSZ(t3) + __WSZ(t4))
+#define __WARGS6(t1, a1, t2, a2, t3, a3, t4, a4, t5, a5, t6, a6) \
+	__WARGS5(t1, a1, t2, a2, t3, a3, t4, a4, t5, a5), \
+	__WGET(t6, __WSZ(t1) + __WSZ(t2) + __WSZ(t3) + __WSZ(t4) + __WSZ(t5))
+
+#define __WASM_REGS_TO_ARGS(x, ...)	__WARGS##x(__VA_ARGS__)
+
+#define __SYSCALL_DEFINEx(x, name, ...)					\
+	asmlinkage long __wasm_sys##name(const struct pt_regs *regs);	\
+	static inline long __do_sys##name(__MAP(x,__SC_DECL,__VA_ARGS__)); \
+	__SYSCALL_SE_DEFINEx(x, sys, name, __VA_ARGS__)			\
+	{								\
+		long ret = __do_sys##name(__MAP(x,__SC_CAST,__VA_ARGS__)); \
+		__MAP(x,__SC_TEST,__VA_ARGS__);				\
+		__PROTECT(x, ret,__MAP(x,__SC_ARGS,__VA_ARGS__));	\
+		return ret;						\
+	}								\
+	asmlinkage long __wasm_sys##name(const struct pt_regs *regs)	\
+	{								\
+		return __se_sys##name(__WASM_REGS_TO_ARGS(x,__VA_ARGS__)); \
+	}								\
+	static inline long __do_sys##name(__MAP(x,__SC_DECL,__VA_ARGS__))
+
+#define SYSCALL_DEFINE0(sname)						\
+	SYSCALL_METADATA(_##sname, 0);					\
+	asmlinkage long __wasm_sys_##sname(const struct pt_regs *__unused); \
+	asmlinkage long __wasm_sys_##sname(const struct pt_regs *__unused)
+
+#define COND_SYSCALL(name)						\
+	asmlinkage long __weak __wasm_sys_##name(const struct pt_regs *regs); \
+	asmlinkage long __weak __wasm_sys_##name(const struct pt_regs *regs) \
+	{								\
+		return sys_ni_syscall();				\
+	}
+
+#endif
diff --git a/arch/wasm/include/asm/thread_info.h b/arch/wasm/include/asm/thread_info.h
new file mode 100644
index 000000000..4d41ab51e
--- /dev/null
+++ b/arch/wasm/include/asm/thread_info.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _ASM_WASM_THREAD_INFO_H
+#define _ASM_WASM_THREAD_INFO_H
+
+#include <asm/page.h>
+
+#define THREAD_SIZE_ORDER	CONFIG_WASM_KERNEL_STACK_ORDER
+#define THREAD_SIZE		(PAGE_SIZE << THREAD_SIZE_ORDER)
+
+/*
+ * The top of every kernel stack holds the task's pt_regs and below that
+ * the worker's TLS block.  The shadow stack pointer starts below both.
+ */
+#define WASM_TLS_RESERVE	64
+
+#ifndef __ASSEMBLER__
+
+#include <asm/processor.h>
+
+struct thread_info {
+	unsigned long		flags;
+	int			preempt_count;
+};
+
+#define INIT_THREAD_INFO(tsk)			\
+{						\
+	.flags		= 0,			\
+	.preempt_count	= INIT_PREEMPT_COUNT,	\
+}
+
+#endif /* __ASSEMBLER__ */
+
+#include <asm-generic/thread_info_tif.h>
+
+/* syscall work flags (no GENERIC_ENTRY) */
+#define TIF_SYSCALL_TRACE	16
+#define TIF_SYSCALL_AUDIT	17
+#define TIF_SYSCALL_TRACEPOINT	18
+#define TIF_SECCOMP		19
+#define _TIF_SYSCALL_TRACE	BIT(TIF_SYSCALL_TRACE)
+#define _TIF_SYSCALL_AUDIT	BIT(TIF_SYSCALL_AUDIT)
+#define _TIF_SYSCALL_TRACEPOINT	BIT(TIF_SYSCALL_TRACEPOINT)
+#define _TIF_SECCOMP		BIT(TIF_SECCOMP)
+
+#define _TIF_WORK_MASK	(_TIF_SIGPENDING | _TIF_NEED_RESCHED | \
+			 _TIF_NOTIFY_RESUME | _TIF_NOTIFY_SIGNAL)
+
+#endif /* _ASM_WASM_THREAD_INFO_H */
