diff --git a/arch/wasm/kernel/binfmt_wasm.c b/arch/wasm/kernel/binfmt_wasm.c
new file mode 100644
index 000000000..eee813620
--- /dev/null
+++ b/arch/wasm/kernel/binfmt_wasm.c
@@ -0,0 +1,292 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * binfmt_wasm: run position independent WebAssembly modules.
+ *
+ * A user program is a wasm module linked with "wasm-ld -pie".  It imports
+ * the shared memory, __memory_base, __table_base, __stack_pointer and its
+ * function table, and its "dylink.0" custom section says how much memory
+ * its data and bss need.
+ *
+ * The kernel lays out the process (data/bss, a TLS block, the stack and
+ * the argv/envp/auxv block) in one !MMU mapping.  The host compiles and
+ * instantiates the module once the task returns to user space, using the
+ * parameters in thread.exec_info.
+ */
+
+#include <linux/init.h>
+#include <linux/binfmts.h>
+#include <linux/fs.h>
+#include <linux/mm.h>
+#include <linux/mman.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/random.h>
+#include <linux/personality.h>
+#include <linux/sched/task_stack.h>
+#include <linux/cred.h>
+#include <linux/auxvec.h>
+
+#define WASM_MAX_IMAGE		(64 << 20)
+#define WASM_USER_TLS		4096
+#define WASM_DYLINK_MEM_INFO	1
+
+struct dylink_info {
+	u32 mem_size;
+	u32 mem_align;		/* log2 */
+	u32 table_size;
+	u32 table_align;	/* log2 */
+};
+
+static int leb_u32(const u8 **p, const u8 *end, u32 *out)
+{
+	u32 v = 0;
+	int shift = 0;
+
+	while (*p < end && shift < 35) {
+		u8 b = *(*p)++;
+
+		v |= (u32)(b & 0x7f) << shift;
+		if (!(b & 0x80)) {
+			*out = v;
+			return 0;
+		}
+		shift += 7;
+	}
+	return -ENOEXEC;
+}
+
+static int parse_dylink(const u8 *img, size_t len, struct dylink_info *di)
+{
+	const u8 *p = img + 8, *end = img + len;
+
+	while (p < end) {
+		const u8 *sec, *q;
+		u32 size, nlen;
+		u8 id = *p++;
+
+		if (leb_u32(&p, end, &size) || size > end - p)
+			return -ENOEXEC;
+		sec = p;
+		p += size;
+		if (id != 0)
+			continue;
+
+		q = sec;
+		if (leb_u32(&q, p, &nlen) || nlen > p - q)
+			return -ENOEXEC;
+		if (nlen != 8 || memcmp(q, "dylink.0", 8))
+			continue;
+		q += nlen;
+
+		while (q < p) {
+			u8 type = *q++;
+			u32 slen;
+			const u8 *r;
+
+			if (leb_u32(&q, p, &slen) || slen > p - q)
+				return -ENOEXEC;
+			r = q;
+			q += slen;
+			if (type != WASM_DYLINK_MEM_INFO)
+				continue;
+			if (leb_u32(&r, q, &di->mem_size) ||
+			    leb_u32(&r, q, &di->mem_align) ||
+			    leb_u32(&r, q, &di->table_size) ||
+			    leb_u32(&r, q, &di->table_align))
+				return -ENOEXEC;
+			return 0;
+		}
+		return -ENOEXEC;
+	}
+
+	/* not a PIE module: we can't place it */
+	return -ENOEXEC;
+}
+
+#define NEW_AUX_ENT(id, val)		\
+	do {				\
+		auxv[nauxv++] = (id);	\
+		auxv[nauxv++] = (val);	\
+	} while (0)
+
+/*
+ * Build argc, argv[], envp[] and auxv[] below the strings that
+ * transfer_args_to_stack() put at @strings.
+ */
+static int create_wasm_tables(struct linux_binprm *bprm, unsigned long *sp_p,
+			      unsigned long strings)
+{
+	struct mm_struct *mm = current->mm;
+	unsigned long sp = *sp_p, p = strings;
+	unsigned long __user *tbl;
+	unsigned long auxv[24];
+	unsigned long rnd_addr;
+	u8 rnd[16];
+	int nauxv = 0, i, n;
+	long len;
+
+	sp -= sizeof(rnd);
+	rnd_addr = sp;
+	get_random_bytes(rnd, sizeof(rnd));
+	if (copy_to_user((void __user *)rnd_addr, rnd, sizeof(rnd)))
+		return -EFAULT;
+
+	NEW_AUX_ENT(AT_PAGESZ, PAGE_SIZE);
+	NEW_AUX_ENT(AT_UID, from_kuid_munged(current_user_ns(), current_uid()));
+	NEW_AUX_ENT(AT_EUID, from_kuid_munged(current_user_ns(), current_euid()));
+	NEW_AUX_ENT(AT_GID, from_kgid_munged(current_user_ns(), current_gid()));
+	NEW_AUX_ENT(AT_EGID, from_kgid_munged(current_user_ns(), current_egid()));
+	NEW_AUX_ENT(AT_SECURE, bprm->secureexec);
+	NEW_AUX_ENT(AT_RANDOM, rnd_addr);
+	NEW_AUX_ENT(AT_EXECFN, bprm->exec);
+	NEW_AUX_ENT(AT_NULL, 0);
+
+	n = 1 + bprm->argc + 1 + bprm->envc + 1 + nauxv;
+	sp -= n * sizeof(unsigned long);
+	sp &= ~15UL;
+	tbl = (unsigned long __user *)sp;
+
+	if (put_user(bprm->argc, tbl++))
+		return -EFAULT;
+
+	mm->arg_start = p;
+	for (i = 0; i < bprm->argc; i++) {
+		if (put_user(p, tbl++))
+			return -EFAULT;
+		len = strnlen_user((const char __user *)p, MAX_ARG_STRLEN);
+		if (!len || len > MAX_ARG_STRLEN)
+			return -EINVAL;
+		p += len;
+	}
+	if (put_user(0, tbl++))
+		return -EFAULT;
+	mm->arg_end = p;
+
+	mm->env_start = p;
+	for (i = 0; i < bprm->envc; i++) {
+		if (put_user(p, tbl++))
+			return -EFAULT;
+		len = strnlen_user((const char __user *)p, MAX_ARG_STRLEN);
+		if (!len || len > MAX_ARG_STRLEN)
+			return -EINVAL;
+		p += len;
+	}
+	if (put_user(0, tbl++))
+		return -EFAULT;
+	mm->env_end = p;
+
+	if (copy_to_user(tbl, auxv, nauxv * sizeof(unsigned long)))
+		return -EFAULT;
+
+	*sp_p = sp;
+	return 0;
+}
+
+static int load_wasm_binary(struct linux_binprm *bprm)
+{
+	static const u8 magic[8] = { 0, 'a', 's', 'm', 1, 0, 0, 0 };
+	struct task_struct *tsk = current;
+	struct wasm_user_start *st = &tsk->thread.exec_info;
+	struct dylink_info di = { 0 };
+	unsigned long stack_size, data_size, total, region, sp, strings;
+	loff_t size, pos = 0;
+	void *image;
+	int ret;
+
+	if (memcmp(bprm->buf, magic, sizeof(magic)))
+		return -ENOEXEC;
+
+	size = i_size_read(file_inode(bprm->file));
+	if (size < 8 || size > WASM_MAX_IMAGE)
+		return -ENOEXEC;
+
+	image = kvmalloc(size, GFP_KERNEL);
+	if (!image)
+		return -ENOMEM;
+	if (kernel_read(bprm->file, image, size, &pos) != size) {
+		ret = -EIO;
+		goto out_free;
+	}
+	ret = parse_dylink(image, size, &di);
+	if (ret)
+		goto out_free;
+	if (di.mem_align > PAGE_SHIFT) {
+		ret = -ENOEXEC;
+		goto out_free;
+	}
+
+	ret = begin_new_exec(bprm);
+	if (ret)
+		goto out_free;
+
+	set_personality(PER_LINUX);
+	setup_new_exec(bprm);
+
+	/* data+bss | TLS | stack (argument block at the very top) */
+	data_size = ALIGN(di.mem_size, 16);
+	stack_size = CONFIG_WASM_USER_STACK_SIZE * 1024 +
+		     (MAX_ARG_PAGES * PAGE_SIZE - bprm->p) + PAGE_SIZE;
+	total = PAGE_ALIGN(data_size + WASM_USER_TLS + stack_size);
+
+	region = vm_mmap(NULL, 0, total, PROT_READ | PROT_WRITE | PROT_EXEC,
+			 MAP_PRIVATE | MAP_ANONYMOUS, 0);
+	if (IS_ERR_VALUE(region)) {
+		ret = region;
+		goto out_free;
+	}
+	if (clear_user((void __user *)region, total)) {
+		ret = -EFAULT;
+		goto out_free;
+	}
+
+	tsk->mm->start_code = 0;
+	tsk->mm->end_code = 0;
+	tsk->mm->start_data = region;
+	tsk->mm->end_data = region + di.mem_size;
+	tsk->mm->start_brk = tsk->mm->brk = region + data_size;
+	tsk->mm->context.end_brk = tsk->mm->start_brk;
+
+	sp = region + total;
+	ret = transfer_args_to_stack(bprm, &sp);
+	if (ret)
+		goto out_free;
+	strings = sp;
+	ret = create_wasm_tables(bprm, &sp, strings);
+	if (ret)
+		goto out_free;
+	tsk->mm->start_stack = sp;
+
+	st->image = (u32)(unsigned long)image;
+	st->image_len = size;
+	st->mem_base = region;
+	st->table_size = di.table_size;
+	st->stack_top = sp;
+	st->args = sp;
+	st->tls_base = region + data_size;
+	st->pid = task_pid_nr(tsk);
+
+	if (tsk->thread.exec_image)
+		kvfree(tsk->thread.exec_image);
+	tsk->thread.exec_image = image;
+	tsk->thread.exec_pending = 1;
+	tsk->thread.sigmailbox = 0;
+
+	finalize_exec(bprm);
+	return 0;
+
+out_free:
+	kvfree(image);
+	return ret;
+}
+
+static struct linux_binfmt wasm_format = {
+	.module		= THIS_MODULE,
+	.load_binary	= load_wasm_binary,
+};
+
+static int __init init_wasm_binfmt(void)
+{
+	register_binfmt(&wasm_format);
+	return 0;
+}
+core_initcall(init_wasm_binfmt);
diff --git a/arch/wasm/kernel/entry.c b/arch/wasm/kernel/entry.c
new file mode 100644
index 000000000..3d8a06d4a
--- /dev/null
+++ b/arch/wasm/kernel/entry.c
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Entry from and exit to user space.
+ *
+ * User programs import the kernel's "syscall" export directly, so a system
+ * call is a plain wasm call from the user module into the kernel module on
+ * the same worker.  There is no trap frame to build; the arguments are
+ * copied into the task's pt_regs for the benefit of generic code.
+ */
+
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/sched/task_stack.h>
+#include <linux/resume_user_mode.h>
+#include <linux/syscalls.h>
+#include <linux/mm.h>
+#include <linux/slab.h>
+
+#include <asm/syscall.h>
+#include <asm/wasm.h>
+
+#include "wasm_internal.h"
+
+void wasm_exit_to_user(struct pt_regs *regs)
+{
+	unsigned long flags;
+
+	local_irq_disable();
+	while ((flags = read_thread_flags()) & _TIF_WORK_MASK) {
+		local_irq_enable();
+		if (flags & _TIF_NEED_RESCHED)
+			schedule();
+		if (flags & (_TIF_SIGPENDING | _TIF_NOTIFY_SIGNAL))
+			wasm_do_signal(regs);
+		if (flags & _TIF_NOTIFY_RESUME)
+			resume_user_mode_work(regs);
+		local_irq_disable();
+	}
+	local_irq_enable();
+
+	if (unlikely(current->thread.exec_pending))
+		wasm_start_exec();
+
+	current->thread.in_user = 1;
+}
+
+static long wasm_dispatch(struct pt_regs *regs)
+{
+	unsigned long nr = regs->nr;
+
+	if (likely(nr < NR_syscalls))
+		return sys_call_table[nr](regs);
+	return -ENOSYS;
+}
+
+__wasm_export("syscall")
+long wasm_syscall(long nr, long a0, long a1, long a2, long a3, long a4,
+		  long a5)
+{
+	struct task_struct *tsk = current;
+	struct pt_regs *regs = task_pt_regs(tsk);
+
+	tsk->thread.in_user = 0;
+
+	/* the program image has been compiled by now */
+	if (unlikely(tsk->thread.exec_image)) {
+		kvfree(tsk->thread.exec_image);
+		tsk->thread.exec_image = NULL;
+	}
+
+	regs->nr = nr;
+	regs->args[0] = a0;
+	regs->args[1] = a1;
+	regs->args[2] = a2;
+	regs->args[3] = a3;
+	regs->args[4] = a4;
+	regs->args[5] = a5;
+	regs->orig_a0 = a0;
+	regs->user = 1;
+
+	/* user mode runs with interrupts on: deliver anything pending now */
+	local_irq_enable();
+
+	do {
+		tsk->thread.restart = 0;
+		regs->ret = wasm_dispatch(regs);
+		wasm_exit_to_user(regs);
+	} while (unlikely(tsk->thread.restart));
+
+	return regs->ret;
+}
+
+/*
+ * The host caught a trap (unreachable, out of bounds access, stack
+ * exhaustion, bad indirect call, ...) while user code was running.
+ */
+__wasm_export("user_fault")
+void wasm_user_fault(int kind)
+{
+	struct task_struct *tsk = current;
+
+	tsk->thread.in_user = 0;
+	local_irq_enable();
+	pr_info("%s[%d]: killed by wasm trap %d\n", tsk->comm,
+		task_pid_nr(tsk), kind);
+	do_group_exit(SIGSEGV);
+}
+
+__wasm_export("in_user")
+int wasm_in_user(void)
+{
+	return current->thread.in_user;
+}
diff --git a/arch/wasm/kernel/irq.c b/arch/wasm/kernel/irq.c
new file mode 100644
index 000000000..da87a2953
--- /dev/null
+++ b/arch/wasm/kernel/irq.c
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Virtual interrupt controller.
+ *
+ * wasm_irq_pending is a bitmask in shared memory.  Host code (timer worker,
+ * device workers, the page's main thread) sets bits with Atomics.or() and
+ * then notifies the address, which wakes the idle loop if the CPU is idle.
+ * The kernel collects the bits whenever interrupts become enabled.
+ */
+
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/hardirq.h>
+#include <linux/irqchip.h>
+#include <linux/sched.h>
+
+#include <asm/wasm.h>
+
+unsigned long wasm_irq_flags = ARCH_IRQ_DISABLED;
+unsigned int wasm_irq_pending;
+
+static struct pt_regs wasm_irq_regs;
+
+void wasm_do_irqs(void)
+{
+	struct pt_regs *old_regs;
+	unsigned int pending;
+
+	wasm_irq_flags = ARCH_IRQ_DISABLED;
+	__wasm_irq_barrier();
+
+	while ((pending = __atomic_exchange_n(&wasm_irq_pending, 0,
+					      __ATOMIC_SEQ_CST))) {
+		old_regs = set_irq_regs(&wasm_irq_regs);
+		irq_enter();
+		while (pending) {
+			unsigned int irq = __builtin_ctz(pending);
+
+			pending &= pending - 1;
+			generic_handle_irq(irq);
+		}
+		irq_exit();
+		set_irq_regs(old_regs);
+	}
+
+	__wasm_irq_barrier();
+	wasm_irq_flags = ARCH_IRQ_ENABLED;
+}
+
+static void wasm_irq_noop(struct irq_data *d)
+{
+}
+
+static struct irq_chip wasm_irq_chip = {
+	.name		= "wasm",
+	.irq_mask	= wasm_irq_noop,
+	.irq_unmask	= wasm_irq_noop,
+	.irq_ack	= wasm_irq_noop,
+};
+
+void __init init_IRQ(void)
+{
+	int i;
+
+	for (i = 0; i < WASM_NR_IRQS; i++) {
+		irq_set_chip_and_handler(i, &wasm_irq_chip, handle_simple_irq);
+		irq_modify_status(i, IRQ_NOREQUEST | IRQ_NOAUTOEN, IRQ_NOPROBE);
+	}
+}
+
+/*
+ * The idle task parks the boot worker until an interrupt arrives.  The
+ * host notifies &wasm_irq_pending after setting a bit.
+ */
+void arch_cpu_idle(void)
+{
+	if (!__atomic_load_n(&wasm_irq_pending, __ATOMIC_SEQ_CST))
+		__builtin_wasm_memory_atomic_wait32((int *)&wasm_irq_pending,
+						    0, -1);
+	raw_local_irq_enable();
+}
diff --git a/arch/wasm/kernel/process.c b/arch/wasm/kernel/process.c
new file mode 100644
index 000000000..c048096fb
--- /dev/null
+++ b/arch/wasm/kernel/process.c
@@ -0,0 +1,341 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Tasks, workers and context switching.
+ *
+ * A wasm instance can't save its call stack and resume another one, so a
+ * task's kernel context can't be switched the usual way.  Instead every
+ * task normally gets a host worker of its own, running its own instance of
+ * the kernel module.  All instances share one linear memory.
+ *
+ * Exactly one worker runs at a time.  Switching from task A to task B
+ * stores "run B" into B's worker control block (wctl), wakes it with
+ * memory.atomic.notify, and then parks A's worker with memory.atomic.wait
+ * until somebody switches back to a task it hosts.
+ *
+ * A worker can host more than one task's context: a vfork() child runs on
+ * its parent's worker (it shares the parent's wasm call stack, exactly
+ * like vfork shares the parent's stack on real hardware) while the parent
+ * is frozen.  The parent's context then isn't a live set of frames but a
+ * "resume point": longjmp back into the vfork() call site.  When the child
+ * execs it migrates to a fresh worker; when it exits the parent resumes.
+ */
+
+#include <linux/sched.h>
+#include <linux/sched/task.h>
+#include <linux/sched/task_stack.h>
+#include <linux/sched/debug.h>
+#include <linux/sched/signal.h>
+#include <linux/slab.h>
+#include <linux/ptrace.h>
+#include <linux/reboot.h>
+#include <linux/pm.h>
+#include <linux/printk.h>
+
+#include <asm/wasm.h>
+#include <asm/switch_to.h>
+
+#include "wasm_internal.h"
+
+__thread struct task_struct *wasm_current_task;
+__thread struct wasm_wctl *wasm_this_wctl;
+
+struct wasm_wctl wasm_boot_wctl = {
+	.nr_hosted	= 1,
+	.refs		= ATOMIC_INIT(1),
+};
+
+struct wasm_wctl *wasm_wctl_alloc(void)
+{
+	struct wasm_wctl *w = kzalloc(sizeof(*w), GFP_KERNEL);
+
+	if (w) {
+		w->nr_hosted = 1;
+		atomic_set(&w->refs, 1);
+	}
+	return w;
+}
+
+void wasm_wctl_put(struct wasm_wctl *w)
+{
+	if (w && w != &wasm_boot_wctl && atomic_dec_and_test(&w->refs))
+		kfree(w);
+}
+
+/* TLS block and initial shadow stack pointer on a task's own stack */
+static unsigned long task_tls(struct task_struct *p)
+{
+	return (unsigned long)task_pt_regs(p) - WASM_TLS_RESERVE;
+}
+
+static unsigned long task_ksp(struct task_struct *p)
+{
+	return task_tls(p) & ~15UL;
+}
+
+void wasm_spawn_worker(struct task_struct *p)
+{
+	wasm_host_spawn(p, p->thread.wctl, task_ksp(p), task_tls(p));
+}
+
+int copy_thread(struct task_struct *p, const struct kernel_clone_args *args)
+{
+	struct pt_regs *childregs = task_pt_regs(p);
+	struct thread_struct *t = &p->thread;
+
+	memset(t, 0, sizeof(*t));
+
+	if (args->fn) {
+		/* kernel thread, or user_mode_thread() that will execve */
+		memset(childregs, 0, sizeof(*childregs));
+		childregs->nr = -1;
+		t->fn = args->fn;
+		t->fn_arg = args->fn_arg;
+	} else if (current->thread.vforking) {
+		/* vfork child: borrows the parent's worker until exec/exit */
+		*childregs = *current_pt_regs();
+		childregs->ret = 0;
+		t->wctl = current->thread.wctl;
+		t->wctl->nr_hosted++;
+		atomic_inc(&t->wctl->refs);
+		t->ctx = WASM_CTX_NATIVE;
+		t->vfork_parent = current;
+		t->sigmailbox = current->thread.sigmailbox;
+		current->thread.vfork_child = p;
+		return 0;
+	} else {
+		/* fork() would have to duplicate a wasm call stack */
+		return -ENOSYS;
+	}
+
+	t->wctl = wasm_wctl_alloc();
+	if (!t->wctl)
+		return -ENOMEM;
+	t->ctx = WASM_CTX_FORK;
+	wasm_spawn_worker(p);
+	return 0;
+}
+
+void arch_release_task_struct(struct task_struct *tsk)
+{
+	struct wasm_wctl *w = tsk->thread.wctl;
+
+	if (!w || w == &wasm_boot_wctl)
+		return;
+
+	/* copy_process() failed after copy_thread(): the worker never ran */
+	if (tsk->thread.ctx == WASM_CTX_FORK)
+		wasm_host_kill_worker(w);
+
+	if (tsk->thread.exec_image) {
+		kvfree(tsk->thread.exec_image);
+		tsk->thread.exec_image = NULL;
+	}
+	tsk->thread.wctl = NULL;
+	wasm_wctl_put(w);
+}
+
+/*
+ * A vfork child is gone from its parent's worker (it exited, or it exec'd
+ * and moved to a worker of its own).  Let the parent run again.
+ */
+void exit_thread(struct task_struct *tsk)
+{
+	struct task_struct *parent = tsk->thread.vfork_parent;
+
+	if (parent) {
+		tsk->thread.vfork_parent = NULL;
+		parent->thread.vfork_child = NULL;
+		wake_up_process(parent);
+	}
+}
+
+/*
+ * Resume a vfork parent: its context is the vfork() call site in user
+ * space.  Finish the context switch the way schedule() would, then unwind
+ * everything on this worker's wasm stack back to the parent's setjmp.
+ */
+static void __noreturn wasm_vfork_resume(struct task_struct *last)
+{
+	struct task_struct *tsk = current;
+	struct task_struct *wake = tsk->thread.vfork_wake;
+	unsigned long jmpbuf = tsk->thread.vfork_jmpbuf;
+	long pid = tsk->thread.vfork_pid;
+
+	tsk->thread.ctx = WASM_CTX_NATIVE;
+	tsk->thread.vfork_jmpbuf = 0;
+	wasm_schedule_resume(last);
+
+	if (wake) {
+		tsk->thread.vfork_wake = NULL;
+		wake_up_process(wake);
+	}
+
+	local_irq_enable();
+	tsk->thread.in_user = 1;
+	wasm_host_vfork_resume(jmpbuf, pid);
+}
+
+struct task_struct *__switch_to(struct task_struct *prev,
+				struct task_struct *next)
+{
+	struct wasm_wctl *me = wasm_this_wctl;
+	struct wasm_wctl *dst = next->thread.wctl;
+
+	if (READ_ONCE(prev->__state) == TASK_DEAD)
+		me->nr_hosted--;
+
+	if (dst == me) {
+		/* both contexts live on this worker: just change identity */
+		me->last = prev;
+		me->active = next;
+	} else {
+		bool worker_done = me->nr_hosted == 0;
+
+		dst->active = next;
+		dst->last = prev;
+		__atomic_store_n(&dst->futex, 1, __ATOMIC_SEQ_CST);
+		__builtin_wasm_memory_atomic_notify((int *)&dst->futex, 1);
+
+		/*
+		 * From here on the next task runs concurrently with us, and
+		 * may free prev's stack.  Don't touch anything but our wctl.
+		 */
+		if (worker_done)
+			wasm_host_exit_worker();
+
+		while (!__atomic_load_n(&me->futex, __ATOMIC_ACQUIRE))
+			__builtin_wasm_memory_atomic_wait32((int *)&me->futex,
+							    0, -1);
+		me->futex = 0;
+	}
+
+	wasm_current_task = me->active;
+	if (me->active->thread.ctx == WASM_CTX_VFORK_RESUME)
+		wasm_vfork_resume(me->last);
+
+	return me->last;
+}
+
+/*
+ * Entry point of a new worker.  The host has set up __stack_pointer and
+ * TLS for task @p's kernel stack.  Wait until the scheduler picks @p, then
+ * behave like ret_from_fork.
+ */
+__wasm_export("task_entry")
+void wasm_task_entry(struct task_struct *p)
+{
+	struct wasm_wctl *me = p->thread.wctl;
+
+	wasm_this_wctl = me;
+	while (!__atomic_load_n(&me->futex, __ATOMIC_ACQUIRE))
+		__builtin_wasm_memory_atomic_wait32((int *)&me->futex, 0, -1);
+	me->futex = 0;
+
+	wasm_current_task = me->active;
+	p->thread.ctx = WASM_CTX_NATIVE;
+	schedule_tail(me->last);
+
+	if (p->thread.fn) {
+		int (*fn)(void *) = p->thread.fn;
+
+		p->thread.fn = NULL;
+		fn(p->thread.fn_arg);
+		/* user_mode_thread(): returns after a successful execve */
+	}
+
+	wasm_exit_to_user(task_pt_regs(p));
+
+	/* a user context without a program to run */
+	pr_err("%s[%d]: no user program to return to\n", p->comm, p->pid);
+	do_exit(SIGKILL);
+}
+
+/*
+ * A vfork child exec'd successfully.  Move it to a worker of its own and
+ * hand this worker back to the parent.
+ */
+static void __noreturn wasm_exec_detach(void)
+{
+	struct task_struct *child = current;
+	struct task_struct *parent = child->thread.vfork_parent;
+	struct wasm_wctl *old = child->thread.wctl;
+	struct wasm_wctl *w = wasm_wctl_alloc();
+
+	if (!w) {
+		pr_err("%s[%d]: no memory for a worker\n", child->comm,
+		       child->pid);
+		do_exit(SIGKILL);
+	}
+
+	child->thread.wctl = w;
+	child->thread.ctx = WASM_CTX_FORK;
+	child->thread.vfork_parent = NULL;
+	old->nr_hosted--;
+	wasm_wctl_put(old);
+
+	parent->thread.vfork_child = NULL;
+	parent->thread.vfork_wake = child;
+
+	wasm_spawn_worker(child);
+
+	/*
+	 * Park the child until the parent has taken over this worker; the
+	 * parent wakes it in wasm_vfork_resume().  The switch away from us
+	 * never returns here.
+	 */
+	set_current_state(TASK_UNINTERRUPTIBLE);
+	wake_up_process(parent);
+	schedule();
+	BUG();
+}
+
+void __noreturn wasm_start_exec(void)
+{
+	struct task_struct *tsk = current;
+
+	if (tsk->thread.vfork_parent)
+		wasm_exec_detach();
+
+	tsk->thread.exec_pending = 0;
+	tsk->thread.in_user = 1;
+	wasm_host_start_user(&tsk->thread.exec_info);
+}
+
+void flush_thread(void)
+{
+}
+
+unsigned long __get_wchan(struct task_struct *p)
+{
+	return 0;
+}
+
+void show_regs(struct pt_regs *regs)
+{
+	show_regs_print_info(KERN_DEFAULT);
+	pr_info("syscall %ld (%08lx %08lx %08lx %08lx %08lx %08lx) = %ld\n",
+		regs->nr, regs->args[0], regs->args[1], regs->args[2],
+		regs->args[3], regs->args[4], regs->args[5], regs->ret);
+}
+
+void show_stack(struct task_struct *task, unsigned long *sp,
+		const char *loglvl)
+{
+	printk("%s(no stack trace: the wasm engine owns the call stack)\n",
+	       loglvl);
+}
+
+void machine_restart(char *cmd)
+{
+	wasm_host_halt(1);
+}
+
+void machine_halt(void)
+{
+	wasm_host_halt(0);
+}
+
+void machine_power_off(void)
+{
+	wasm_host_halt(0);
+}
