diff --git a/arch/wasm/kernel/sections.c b/arch/wasm/kernel/sections.c
new file mode 100644
index 000000000..5d32f9bd4
--- /dev/null
+++ b/arch/wasm/kernel/sections.c
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Symbols that a linker script would define.  There is no linker script:
+ * code doesn't live in linear memory at all and the data segments aren't
+ * split into the usual regions, so every one of these ranges is empty.
+ *
+ * Deliberately doesn't include the headers declaring them (their types
+ * differ); the linker only cares about the addresses.
+ */
+
+static char wasm_section_anchor[16] __attribute__((aligned(16), used));
+
+#define EMPTY_RANGE(start, stop)					\
+	extern char start[1] __attribute__((alias("wasm_section_anchor"))); \
+	extern char stop[1] __attribute__((alias("wasm_section_anchor")));
+
+EMPTY_RANGE(_stext, _etext)
+EMPTY_RANGE(_sinittext, _einittext)
+EMPTY_RANGE(_sdata, _edata)
+EMPTY_RANGE(__bss_start, __bss_stop)
+EMPTY_RANGE(__init_begin, __init_end)
+EMPTY_RANGE(__start_rodata, __end_rodata)
+EMPTY_RANGE(__start_notes, __stop_notes)
+EMPTY_RANGE(__start___ex_table, __stop___ex_table)
+EMPTY_RANGE(__start___modver, __stop___modver)
diff --git a/arch/wasm/kernel/setup.c b/arch/wasm/kernel/setup.c
new file mode 100644
index 000000000..7c79038c8
--- /dev/null
+++ b/arch/wasm/kernel/setup.c
@@ -0,0 +1,175 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Boot and memory setup.
+ *
+ * The host instantiates the kernel module on a first ("boot") worker,
+ * points __stack_pointer at init_stack, initialises TLS and calls the
+ * exported "boot" function.  That worker becomes CPU 0's idle task.
+ *
+ * Memory layout of the shared linear memory (all of it is "RAM"):
+ *
+ *   0 .. 64K           unused guard area (NULL pointer region)
+ *   64K .. __heap_base  kernel image: data, rodata, bss, linker stack
+ *   __heap_base .. end  page allocator
+ */
+
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/memblock.h>
+#include <linux/mm.h>
+#include <linux/initrd.h>
+#include <linux/sched.h>
+#include <linux/sched/task.h>
+#include <linux/start_kernel.h>
+#include <linux/console.h>
+#include <linux/cpu.h>
+#include <linux/of_fdt.h>
+#include <linux/seq_file.h>
+#include <linux/screen_info.h>
+#include <linux/delay.h>
+
+#include <asm/wasm.h>
+#include <asm/sections.h>
+#include <asm/setup.h>
+
+extern char __heap_base[];
+
+unsigned long memory_end;
+
+#ifdef CONFIG_BLK_DEV_INITRD
+/* No built-in initramfs: the host hands one in as an initrd. */
+char __initramfs_start[1] __initdata;
+unsigned long __initramfs_size __initdata;
+#endif
+void *empty_zero_page;
+EXPORT_SYMBOL(empty_zero_page);
+
+/* TLS block for the boot worker, before any task stack exists */
+static char wasm_boot_tls[WASM_TLS_RESERVE] __aligned(16);
+
+/* Kernel stack of the init task (the boot worker's idle loop) */
+unsigned long init_stack[THREAD_SIZE / sizeof(unsigned long)]
+	__aligned(THREAD_SIZE);
+
+__wasm_export("boot_tls")
+unsigned long wasm_boot_tls_addr(void)
+{
+	return (unsigned long)wasm_boot_tls;
+}
+
+__wasm_export("boot_stack_top")
+unsigned long wasm_boot_stack_top(void)
+{
+	/* leave room for pt_regs and a TLS block like every other task */
+	return (unsigned long)init_stack + THREAD_SIZE -
+		sizeof(struct pt_regs) - WASM_TLS_RESERVE;
+}
+
+__wasm_export("boot")
+void wasm_boot(void)
+{
+	extern struct wasm_wctl wasm_boot_wctl;
+	extern __thread struct wasm_wctl *wasm_this_wctl;
+
+	wasm_current_task = &init_task;
+	wasm_this_wctl = &wasm_boot_wctl;
+	init_task.thread.wctl = &wasm_boot_wctl;
+
+	memory_end = (unsigned long)__builtin_wasm_memory_size(0) << 16;
+
+	start_kernel();
+}
+
+static void __init wasm_setup_initrd(void)
+{
+#ifdef CONFIG_BLK_DEV_INITRD
+	unsigned long size = wasm_host_initrd_size();
+	phys_addr_t addr;
+
+	if (!size)
+		return;
+
+	addr = memblock_phys_alloc(PAGE_ALIGN(size), PAGE_SIZE);
+	if (!addr) {
+		pr_err("initrd: can't allocate %lu bytes\n", size);
+		return;
+	}
+	wasm_host_initrd_load(__va(addr));
+	initrd_start = (unsigned long)__va(addr);
+	initrd_end = initrd_start + size;
+	pr_info("initrd: %lu KiB at %08lx\n", size >> 10, initrd_start);
+#endif
+}
+
+static void __init wasm_paging_init(void)
+{
+	unsigned long max_zone_pfn[MAX_NR_ZONES] = { 0 };
+
+	max_zone_pfn[ZONE_NORMAL] = max_low_pfn;
+	free_area_init(max_zone_pfn);
+}
+
+void __init setup_arch(char **cmdline_p)
+{
+	unsigned long kernel_end = PAGE_ALIGN((unsigned long)__heap_base);
+
+	wasm_host_get_cmdline(boot_command_line, COMMAND_LINE_SIZE);
+	*cmdline_p = boot_command_line;
+
+	init_mm.start_code = 0;
+	init_mm.end_code = 0;
+	init_mm.end_data = kernel_end;
+	init_mm.brk = kernel_end;
+
+	memblock_add(0, memory_end);
+	memblock_reserve(0, kernel_end);
+
+	min_low_pfn = PFN_UP(kernel_end);
+	max_low_pfn = PFN_DOWN(memory_end);
+	max_pfn = max_low_pfn;
+	high_memory = (void *)memory_end;
+
+	pr_info("wasm: %lu MiB linear memory, kernel image %lu KiB\n",
+		memory_end >> 20, kernel_end >> 10);
+
+	wasm_setup_initrd();
+	parse_early_param();
+
+	empty_zero_page = memblock_alloc_or_panic(PAGE_SIZE, PAGE_SIZE);
+
+	wasm_paging_init();
+}
+
+static int show_cpuinfo(struct seq_file *m, void *v)
+{
+	seq_printf(m, "processor\t: 0\n");
+	seq_printf(m, "cpu\t\t: WebAssembly (wasm32)\n");
+	seq_printf(m, "model name\t: Browser worker\n");
+	seq_printf(m, "features\t: atomics bulk-memory mutable-globals sign-ext\n");
+	seq_printf(m, "bogomips\t: %lu.%02lu\n\n",
+		   loops_per_jiffy / (500000 / HZ),
+		   (loops_per_jiffy / (5000 / HZ)) % 100);
+	return 0;
+}
+
+static void *c_start(struct seq_file *m, loff_t *pos)
+{
+	return *pos < 1 ? (void *)1 : NULL;
+}
+
+static void *c_next(struct seq_file *m, void *v, loff_t *pos)
+{
+	++*pos;
+	return NULL;
+}
+
+static void c_stop(struct seq_file *m, void *v)
+{
+}
+
+const struct seq_operations cpuinfo_op = {
+	.start	= c_start,
+	.next	= c_next,
+	.stop	= c_stop,
+	.show	= show_cpuinfo,
+};
diff --git a/arch/wasm/kernel/signal.c b/arch/wasm/kernel/signal.c
new file mode 100644
index 000000000..ffa7f19e1
--- /dev/null
+++ b/arch/wasm/kernel/signal.c
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Signal delivery through a user space mailbox.
+ *
+ * The kernel can't redirect a wasm instance to run a handler.  Instead,
+ * libc registers a struct wasm_sigmailbox (wasm_sigmailbox syscall).  When
+ * a handler has to run, the frame is written there and the syscall returns
+ * normally; the libc syscall wrapper sees "pending", runs the handler and
+ * then calls rt_sigreturn(frame) to restore the signal mask.  If the
+ * interrupted call should be restarted, frame.restart tells libc to issue
+ * it again.
+ */
+
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/signal.h>
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+#include <linux/resume_user_mode.h>
+
+#include <asm/wasm.h>
+
+#include "wasm_internal.h"
+
+static int setup_frame(struct ksignal *ksig, struct pt_regs *regs,
+		       sigset_t *oldset, int restart)
+{
+	struct wasm_sigmailbox __user *mb =
+		(struct wasm_sigmailbox __user *)current->thread.sigmailbox;
+	struct wasm_sigframe frame;
+
+	if (!mb)
+		return -EFAULT;
+
+	memset(&frame, 0, sizeof(frame));
+	frame.handler = (u32)(unsigned long)ksig->ka.sa.sa_handler;
+	frame.flags = ksig->ka.sa.sa_flags;
+	frame.sig = ksig->sig;
+	frame.restart = restart;
+	frame.retval = regs->ret;
+	frame.saved_mask = (u64)oldset->sig[0] |
+			   ((u64)oldset->sig[_NSIG_WORDS - 1] << 32);
+
+	if (copy_to_user(&mb->frame, &frame, offsetof(struct wasm_sigframe, info)))
+		return -EFAULT;
+	if (copy_siginfo_to_user((siginfo_t __user *)mb->frame.info, &ksig->info))
+		return -EFAULT;
+	if (put_user(1, &mb->pending))
+		return -EFAULT;
+	return 0;
+}
+
+void wasm_do_signal(struct pt_regs *regs)
+{
+	struct ksignal ksig;
+	int restart = 0;
+
+	if (get_signal(&ksig)) {
+		if (regs->nr >= 0) {
+			switch (regs->ret) {
+			case -ERESTART_RESTARTBLOCK:
+			case -ERESTARTNOHAND:
+				regs->ret = -EINTR;
+				break;
+			case -ERESTARTSYS:
+				if (!(ksig.ka.sa.sa_flags & SA_RESTART)) {
+					regs->ret = -EINTR;
+					break;
+				}
+				fallthrough;
+			case -ERESTARTNOINTR:
+				restart = 1;
+				break;
+			}
+			regs->nr = -1;
+		}
+		signal_setup_done(setup_frame(&ksig, regs, sigmask_to_save(),
+					      restart), &ksig, 0);
+		return;
+	}
+
+	/* No handler ran: restart the system call ourselves. */
+	if (regs->nr >= 0) {
+		switch (regs->ret) {
+		case -ERESTARTNOHAND:
+		case -ERESTARTSYS:
+		case -ERESTARTNOINTR:
+			current->thread.restart = 1;
+			break;
+		case -ERESTART_RESTARTBLOCK:
+			regs->nr = __NR_restart_syscall;
+			current->thread.restart = 1;
+			break;
+		}
+	}
+
+	restore_saved_sigmask();
+}
+
+SYSCALL_DEFINE1(rt_sigreturn, struct wasm_sigframe __user *, frame)
+{
+	sigset_t set;
+	u64 mask;
+
+	current->restart_block.fn = do_no_restart_syscall;
+
+	if (get_user(mask, &frame->saved_mask))
+		goto badframe;
+
+	sigemptyset(&set);
+	set.sig[0] = (unsigned long)mask;
+	if (_NSIG_WORDS > 1)
+		set.sig[_NSIG_WORDS - 1] = (unsigned long)(mask >> 32);
+	set_current_blocked(&set);
+	return 0;
+
+badframe:
+	force_sig(SIGSEGV);
+	return 0;
+}
