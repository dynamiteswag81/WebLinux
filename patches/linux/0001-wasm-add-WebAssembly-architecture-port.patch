@@ -0,0 +1,40 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# WebAssembly architecture makefile.
+#
+# The final image is vmlinux.wasm, linked straight from vmlinux.a with
+# wasm-ld.  The ELF specific vmlinux steps (modpost, objcopy, sorttable)
+# don't apply, so build with:  make ARCH=wasm LLVM=1 vmlinux.wasm
+#
+
+KBUILD_DEFCONFIG := wasm_defconfig
+
+wasm-features := -matomics -mbulk-memory -mmutable-globals -msign-ext \
+		 -mnontrapping-fptoint
+KBUILD_CFLAGS	+= $(wasm-features) -fno-exceptions
+KBUILD_AFLAGS	+= $(wasm-features)
+KBUILD_RUSTFLAGS +=
+CHECKFLAGS	+= -D__wasm__ -D__wasm32__
+
+# Kernel exports that the host runtime (arch/wasm/host) calls are marked in
+# C with __attribute__((export_name)).  The rest are linker generated.
+WASM_LDFLAGS := --no-entry --import-memory --shared-memory \
+		--max-memory=4294967296 --global-base=65536 \
+		-z stack-size=16384 \
+		--export=__stack_pointer --export=__wasm_init_tls \
+		--export=__tls_size --export=__tls_align --export=__heap_base \
+		--export=__data_end
+
+WASMLD := $(LLVM_PREFIX)wasm-ld$(LLVM_SUFFIX)
+
+PHONY += vmlinux.wasm
+vmlinux.wasm: vmlinux.a FORCE
+	@echo '  WASMLD  $@'
+	$(Q)$(WASMLD) $(WASM_LDFLAGS) -o $@ --whole-archive vmlinux.a \
+		--no-whole-archive $(KBUILD_VMLINUX_LIBS)
+
+all: vmlinux.wasm
+
+define archhelp
+  echo  '* vmlinux.wasm   - Kernel image for the browser host (arch/wasm/host)'
+endef
