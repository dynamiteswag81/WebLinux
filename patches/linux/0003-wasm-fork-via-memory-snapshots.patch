index c3a23b082..0eb64b28f 100644
--- a/mm/nommu.c
+++ b/mm/nommu.c
@@ -1423,6 +1423,10 @@ static int vmi_shrink_vma(struct vma_iterator *vmi,
  * - under NOMMU conditions the chunk to be unmapped must be backed by a single
  *   VMA, though it need not cover the whole VMA
  */
+#ifdef CONFIG_WASM
+bool wasm_munmap_frozen(struct mm_struct *mm, unsigned long start, size_t len);
+#endif
+
 int do_munmap(struct mm_struct *mm, unsigned long start, size_t len, struct list_head *uf)
 {
 	VMA_ITERATOR(vmi, mm, start);
@@ -1436,6 +1440,12 @@ int do_munmap(struct mm_struct *mm, unsigned long start, size_t len, struct list
 
 	end = start + len;
 
+#ifdef CONFIG_WASM
+	/* a frozen fork() parent still owns this memory (arch/wasm/kernel/fork.c) */
+	if (wasm_munmap_frozen(mm, start, len))
+		return 0;
+#endif
+
 	/* find the first potentially overlapping VMA */
 	vma = vma_find(&vmi, end);
 	if (!vma) {
